#!/bin/bash
# 以模块方式运行（python3 -m）：本机 Homebrew python@3.14.6 直接执行脚本文件会偶发 Bus error（SIGBUS）。
# 工程目录按本文件的真实位置推出（会跟随 ~/.local/bin 里的软链接），不写死路径。
src="$0"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$dir/$src"
done
root="$(cd -P "$(dirname "$src")/.." && pwd)"
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m agent_dispatch "$@"
